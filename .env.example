# ==============================================================================
# AI CCTV Platform - Environment Configuration Example
# Copy this file to .env and configure your local environment settings
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Future Integrations (Phase 2+)
# RTSP Video Stream (e.g., rtsp://username:password@192.168.1.100:554/stream1)
RTSP_STREAM_URL=

# Database Settings
DATABASE_URL=sqlite:///./data/cctv_analytics.db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# API Security
API_SECRET_KEY=change-this-to-a-secure-random-key
